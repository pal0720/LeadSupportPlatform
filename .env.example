# Database
DATABASE_URL=postgresql://gtm_user:gtm_password@localhost:5432/gtm_platform

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT & Security
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# AI Providers
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# AI Service
AI_SERVICE_URL=http://localhost:8001

# Environment
ENVIRONMENT=development
DEBUG=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Email (for development use MailHog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@gtmplatform.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Enrichment APIs (optional)
CLEARBIT_API_KEY=
HUNTER_API_KEY=
BUILTWITH_API_KEY=

# CRM Integrations
HUBSPOT_API_KEY=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Feature Flags
FEATURE_AI_AUTOPILOT=true
FEATURE_LIVE_COPILOT=true
FEATURE_AI_QBR_CREATOR=true
FEATURE_LOOKALIKE_FINDER=true
FEATURE_SUPPORT_FORECASTING=true

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics
NEXT_PUBLIC_ANALYTICS_ID=
