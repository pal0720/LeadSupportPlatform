# ================================
# GTM Platform Environment Variables
# ================================
# Copy this file to .env and fill in the values
# NEVER commit .env file to version control!

# ================================
# Application Settings
# ================================
APP_NAME=GTM Platform API
VERSION=1.0.0
ENVIRONMENT=development
# Options: development, staging, production
DEBUG=true
# Set to false in production!

# ================================
# Database Configuration
# ================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gtm_platform
# Format: postgresql+asyncpg://user:password@host:port/database
# Production: Use strong password and restrict access

# ================================
# Redis Configuration
# ================================
REDIS_URL=redis://localhost:6379/0
# Format: redis://host:port/db
# Production: Use password and restrict access

# ================================
# JWT & Authentication
# ================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# CRITICAL: Generate a strong random secret for production
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ================================
# CORS Configuration
# ================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Production: Specify exact domains
# Example: https://app.yourdomain.com,https://yourdomain.com

# ================================
# AI Service Configuration
# ================================
OPENAI_API_KEY=sk-your-openai-api-key-here
# Get from: https://platform.openai.com/api-keys

ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# Get from: https://console.anthropic.com/

AI_SERVICE_URL=http://localhost:8001
# URL to AI service (if running separately)

# ================================
# Email Configuration
# ================================
SMTP_HOST=localhost
SMTP_PORT=1025
# Development: Use MailHog or similar
# Production: Use SendGrid, AWS SES, etc.

SMTP_USER=
SMTP_PASSWORD=
# Leave empty for local development

EMAIL_FROM=noreply@gtmplatform.com

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_PER_MINUTE=60
# Number of requests allowed per minute per user/IP

# ================================
# Data Enrichment APIs
# ================================
CLEARBIT_API_KEY=
# Get from: https://clearbit.com/

HUNTER_API_KEY=
# Get from: https://hunter.io/

BUILTWITH_API_KEY=
# Get from: https://builtwith.com/

# ================================
# CRM Integrations
# ================================
# HubSpot
HUBSPOT_API_KEY=
# Get from: https://app.hubspot.com/

# Salesforce
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_REDIRECT_URI=http://localhost:3000/integrations/salesforce/callback
# Get from: https://developer.salesforce.com/

# ================================
# Payment Processing
# ================================
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
# Production: Use live keys (pk_live_... and sk_live_...)
# Get from: https://dashboard.stripe.com/apikeys

# ================================
# Monitoring & Error Tracking
# ================================
SENTRY_DSN=
# Get from: https://sentry.io/

SENTRY_ENVIRONMENT=development
# Options: development, staging, production

# ================================
# Feature Flags
# ================================
FEATURE_AI_AUTOPILOT=true
FEATURE_LIVE_COPILOT=true
FEATURE_AI_QBR_CREATOR=true
FEATURE_LOOKALIKE_FINDER=true
FEATURE_SUPPORT_FORECASTING=true

# ================================
# Frontend (Next.js)
# ================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics
NEXT_PUBLIC_ANALYTICS_ID=

# ================================
# Production Warnings
# ================================
# BEFORE DEPLOYING TO PRODUCTION:
# 1. Set ENVIRONMENT=production
# 2. Set DEBUG=false
# 3. Generate strong JWT_SECRET
# 4. Use production database credentials
# 5. Use production API keys
# 6. Configure proper CORS_ORIGINS
# 7. Enable HTTPS/TLS
# 8. Set up monitoring (Sentry)
# 9. Configure proper email service
# 10. Review all security settings in SECURITY.md
